{
  "manifest_version": 3,
  "name": "PixelScope - 웹 개발 유틸 모음",
  "short_name": "PixelScope",
  "version": "1.0.5",
  "description": "Measure page regions, inspect colors, and capture page content without changing page layout.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "clipboardWrite"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PixelScope 도구",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  }
}
